rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    //補助関数

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    //変更しようとしているフィールドの集合
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    //値の検証

    function validDisplayName(v) {
      return v is string && v.size() > 0 && v.size() <= 20;
    }

    function validItemName(v) {
      return v is string && v.size() > 0 && v.size() <= 50;
    }

    function validNote(v) {
      return v is string && v.size() <= 200;
    }

    function validCategory(v) {
      return v in ['dailyGoods', 'beverage', 'food', 'freshFood', 'stationery'];
    }

    function validTransportMode(v) {
      return v in ['none', 'walk', 'bike', 'vehicle'];
    }

    function nullOrTimestamp(v) {
      return v == null || v is timestamp;
    }

    function nullOrString(v, maxSize) {
      return v == null || (v is string && v.size() <= maxSize);
    }

    //家から100kmを制限とする
    function validMaxDistance(v) {
      return v == null || (v is number && v > 0 && v <= 100000);
    }

    //以下の5つを満たすリストのみ許可する
    function validAlternatives(v) {
      return v is list && v.size() <= 5
        && (v.size() < 1 || (v[0] is string && v[0].size() > 0 && v[0].size() <= 50))
        && (v.size() < 2 || (v[1] is string && v[1].size() > 0 && v[1].size() <= 50))
        && (v.size() < 3 || (v[2] is string && v[2].size() > 0 && v[2].size() <= 50))
        && (v.size() < 4 || (v[3] is string && v[3].size() > 0 && v[3].size() <= 50))
        && (v.size() < 5 || (v[4] is string && v[4].size() > 0 && v[4].size() <= 50));
    }

    //基準となるラベルの一覧
    function validLabels(v) {
      return v is list && v.size() <= 100;
    }

    function validGeoPoint(v) {
      return v == null
        || (v is map
            && v.keys().hasOnly(['latitude', 'longitude'])
            && v.keys().hasAll(['latitude', 'longitude'])
            && v.latitude is number
            && v.latitude >= -90 && v.latitude <= 90
            && v.longitude is number
            && v.longitude >= -180 && v.longitude <= 180);
    }

    //店舗の指定
    function nullOrStoreId(v) {
      return v == null || v is string;
    }

    //ユーザー情報(users)

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'familyId', 'createdTime'])
        && request.resource.data.keys().hasAll(
             ['displayName', 'familyId', 'createdTime'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.familyId == null
        && request.resource.data.createdTime == request.time;

      // familyId の変更は Cloud Functions のみ
      // hasAll によって、許可フィールド自体の削除も拒否する
      allow update: if isSelf(uid)
        && changed().hasOnly(['displayName'])
        && request.resource.data.keys().hasAll(
             ['displayName', 'familyId', 'createdTime'])
        && validDisplayName(request.resource.data.displayName);

      allow delete: if false;
    }

    //招待コード(inviteCodes)

    match /inviteCodes/{code} {
      // 単体取得のみ。一覧を許可すると総当たりが不要になるため list は禁止
      // App Check は導入しない方針（フェーズ1〜2 時点）
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    //家族分け(families)　

    match /families/{familyId} {
      allow get: if isMember(familyId);
      allow list: if false;

      allow create, delete: if false;

      //家族の情報の変更
      allow update: if isMember(familyId)
        && changed().hasOnly(['homeLocation'])
        && request.resource.data.keys().hasAll([
             'familyName', 'inviteCode', 'creatorUserId', 'createdTime',
             'homeLocation'])
        && validGeoPoint(request.resource.data.homeLocation);

      //各家族メンバーmembers

      match /members/{uid} {
        allow read: if isMember(familyId);
        allow create, delete: if false;

        allow update: if isSelf(uid)
          && changed().hasOnly([
               'displayName',
               'transportMode',
               'transportModeExpireTime',
               'busyUntilTime',
               'busyLabel',
               'fcmToken'])
          && request.resource.data.keys().hasAll([
               'displayName', 'transportMode', 'transportModeExpireTime',
               'busyUntilTime', 'busyLabel'])
          && validDisplayName(request.resource.data.displayName)
          && validTransportMode(request.resource.data.transportMode)
          && nullOrTimestamp(request.resource.data.transportModeExpireTime)
          && nullOrTimestamp(request.resource.data.busyUntilTime)
          && nullOrString(request.resource.data.busyLabel, 20)
          && nullOrString(request.resource.data.get('fcmToken', null), 4096);
      }

      //不足品(items)

      match /items/{itemId} {
        allow read: if isMember(familyId);

        allow create: if isMember(familyId)
          && request.resource.data.keys().hasOnly([
               'itemName', 'category', 'status',
               'alternativeItemNames', 'maxDistanceMeters', 'note',
               'autoNotifyEnabled', 'creatorUserId', 'createdTime',
               'requestedTime', 'requesterUserId', 'isImportant',
               'completedTime', 'activeAssignmentId', 'rejectedUserIds',
               'preferredStoreId'])
          && request.resource.data.keys().hasAll([
               'itemName', 'category', 'status',
               'alternativeItemNames', 'maxDistanceMeters', 'note',
               'autoNotifyEnabled', 'creatorUserId', 'createdTime',
               'requestedTime', 'requesterUserId', 'isImportant',
               'completedTime', 'activeAssignmentId', 'rejectedUserIds',
               'preferredStoreId'])
          && request.resource.data.creatorUserId == request.auth.uid
          && request.resource.data.status == 'shortage'
          && request.resource.data.createdTime == request.time
          && request.resource.data.requestedTime == null
          && request.resource.data.requesterUserId == null
          && request.resource.data.isImportant == false
          && request.resource.data.completedTime == null
          && request.resource.data.activeAssignmentId == null
          && request.resource.data.rejectedUserIds == []
          && nullOrStoreId(request.resource.data.preferredStoreId)
          && validItemName(request.resource.data.itemName)
          && validCategory(request.resource.data.category)
          && validNote(request.resource.data.note)
          && request.resource.data.autoNotifyEnabled is bool
          && validMaxDistance(request.resource.data.maxDistanceMeters)
          && validAlternatives(request.resource.data.alternativeItemNames);

        //遷移状態の管理は Cloud Functions で行う
        allow update: if isMember(familyId)
          //担当が決まっている間は担当者だけが編集できる
          && (resource.data.activeAssignmentId == null
              || resource.data.activeAssignmentId == itemId + '_' + request.auth.uid)
          && changed().hasOnly([
               'itemName', 'category', 'alternativeItemNames',
               'maxDistanceMeters', 'note', 'autoNotifyEnabled', 'preferredStoreId'])
          && request.resource.data.keys().hasAll([
               'itemName', 'category', 'status',
               'alternativeItemNames', 'maxDistanceMeters', 'note',
               'autoNotifyEnabled', 'creatorUserId', 'createdTime',
               'requestedTime', 'requesterUserId', 'isImportant',
               'completedTime', 'activeAssignmentId', 'rejectedUserIds',
               'preferredStoreId'])
          && validItemName(request.resource.data.itemName)
          && validCategory(request.resource.data.category)
          && validNote(request.resource.data.note)
          && request.resource.data.autoNotifyEnabled is bool
          && validMaxDistance(request.resource.data.maxDistanceMeters)
          && validAlternatives(request.resource.data.alternativeItemNames)
          && nullOrStoreId(request.resource.data.preferredStoreId);

        //依頼も担当も付いていない不足品だけを消せる
        allow delete: if isMember(familyId)
          && resource.data.status != 'completed'
          && resource.data.requesterUserId == null
          && resource.data.activeAssignmentId == null;
      }

      //店舗(stores)
      match /stores/{storeId} {
        allow read: if isMember(familyId);
        allow write: if false;
      }

      //割り当て(assignments)

      match /assignments/{assignmentId} {
        allow read: if isMember(familyId);
        allow write: if false;

        //割り当ての状態変更
        match /messages/{messageId} {
          allow read: if isMember(familyId);

          allow create: if isMember(familyId)
            && request.resource.data.keys().hasOnly([
                 'senderUserId', 'bodyText', 'messageType',
                 'proposalValue', 'sentTime'])
            && request.resource.data.keys().hasAll([
                 'senderUserId', 'bodyText', 'messageType',
                 'proposalValue', 'sentTime'])
            && request.resource.data.senderUserId == request.auth.uid
            && request.resource.data.sentTime == request.time
            && request.resource.data.messageType in [
                 'text', 'alternativeProposal', 'timeChangeProposal']
            && request.resource.data.bodyText is string
            && request.resource.data.bodyText.size() <= 500
            && (request.resource.data.proposalValue == null
                || request.resource.data.proposalValue is string);

          allow update, delete: if false;
        }
      }

      //在庫の基準(stockStandards)

      match /stockStandards/{standardId} {
        allow read: if isMember(familyId);

        allow create, update: if isMember(familyId)
          && request.resource.data.keys().hasOnly(
               ['labels', 'updatedTime', 'updaterUserId'])
          && request.resource.data.keys().hasAll(
               ['labels', 'updatedTime', 'updaterUserId'])
          && validLabels(request.resource.data.labels)
          && request.resource.data.updatedTime == request.time
          && request.resource.data.updaterUserId == request.auth.uid;

        allow delete: if false;
      }
    }
  }
}